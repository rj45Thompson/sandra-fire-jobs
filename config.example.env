# ═══════════════════════════════════════════════════════════
#  Copy to .env and fill in.  .env is gitignored — it never
#  leaves this machine and is never served by the website.
# ═══════════════════════════════════════════════════════════

# ── Gmail ──────────────────────────────────────────────────
# Google has not accepted account passwords for mail since
# May 2022.  Create an APP PASSWORD instead:
#   1. Google Account → Security → 2-Step Verification (must be ON)
#   2. Security → App passwords → name it "fire-jobs"
#   3. Paste the 16-character code below (spaces are fine)
# Revocable any time from that same page, and it cannot be
# used to sign in to the Google account itself.
GMAIL_ADDRESS=sandra.ayany@gmail.com
GMAIL_APP_PASSWORD=

# ── Local API ──────────────────────────────────────────────
API_PORT=8770
# Shared secret so only your browser can drive the backend.
# Any random string; the front-end asks for it once.
API_TOKEN=change-me-to-something-random

# ── Chat backend: "ollama" (local, free) or "anthropic" ────
CHAT_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434
ANTHROPIC_API_KEY=

# ── Automation ─────────────────────────────────────────────
# Never auto-submit without review; queue for approval first.
AUTO_SUBMIT=false
HEADLESS=true

# --- home network access -------------------------------------------------
# 127.0.0.1 = this computer only (default). 0.0.0.0 = also reachable from
# other devices on the same home wifi. Muster refuses any address that is
# not on a home network, so this never exposes it to the internet.
BIND_HOST=127.0.0.1

# A new device on the home network must enter this once before it is let in.
# Leave empty and other devices are refused outright.
ACCESS_PIN=
